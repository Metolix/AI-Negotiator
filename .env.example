# Required in production
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_PASSWORD_HASH=replace-with-werkzeug-password-hash
COOKIE_SECURE=1

# AI provider (optional; without a key the simulator uses its deterministic fallback)
GROQ_API_KEY=replace-with-groq-key
GROQ_MODEL=llama-3.3-70b-versatile

# Optional
MAX_TURNS=50
PORT=5000
